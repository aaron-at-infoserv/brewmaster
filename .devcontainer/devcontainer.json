{
  "name": "brewmaster",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // The model the room is standardised on: Qwen3-32B FP8, served by vLLM on a
  // RunPod GPU rented for the session. FCC has no vLLM provider, but its
  // lmstudio slot is a plain OpenAI-compatible client, which is exactly the
  // shape vLLM serves - so the pod goes there. See docs/05-model-hosting.md in
  // the facilitator repo.
  //
  // The endpoint itself arrives as the LM_STUDIO_BASE_URL Codespaces secret,
  // set once on the repo by the facilitator. It is deliberately NOT baked in
  // here: the URL contains the pod id, which changes whenever the pod is
  // recreated, and a rebuild-to-change-a-URL is not something you want to
  // discover at 09:05 on the day.
  //
  // FCC's lmstudio slot sends the fixed credential "lm-studio" and offers no
  // way to configure it, so vLLM must be started with VLLM_API_KEY=lm-studio.
  //
  // CLAUDE_CODE_MAX_OUTPUT_TOKENS is not optional. Claude Code defaults to
  // requesting 64000 output tokens, which any self-hosted model rejects with a
  // 400 - vLLM enforces max_tokens + prompt_tokens <= max_model_len. Claude
  // Code's own baseline prompt measures ~24.5K tokens, so serve the pod at
  // 65536 context and cap output here.
  //
  // To switch provider live, re-run start-agent.sh with the model you want -
  // the Admin UI is loopback-only and cannot be reached through a forwarded
  // port. The zero-cost fallback if the pod dies:
  //   MODEL=gemini/gemini-flash-latest .devcontainer/start-agent.sh --restart
  //
  // FCC_ENV_FILE keeps the workshop's keys out of ~/.fcc/.env, which fcc owns
  // and rewrites. It is set here rather than only in start-agent.sh so that a
  // plain `fcc-claude` in a fresh terminal reads the same config the running
  // proxy started from - a mismatch there surfaces as a 401 from the proxy.
  "containerEnv": {
    "MODEL": "lmstudio/qwen3-32b",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "FCC_ENV_FILE": "/home/vscode/.fcc/brewmaster.env"
  },

  // Prompted for when a codespace is created. Both are now FALLBACK ONLY - the
  // room runs on the shared pod, which needs no per-person key at all. Leave
  // them blank and everything still works; fill one in and the 90-second
  // switch below is available if the pod misbehaves.
  //
  // LM_STUDIO_BASE_URL is deliberately absent from this block. It is a
  // repo-level Codespaces secret (Settings > Secrets and variables >
  // Codespaces), so it is injected automatically without prompting anyone for
  // a URL they have no way of knowing.
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Optional fallback. Your own Google AI Studio key - free, no card, works with a Google account.",
      "documentationUrl": "https://aistudio.google.com/apikey"
    },
    "CEREBRAS_API_KEY": {
      "description": "Optional third provider, so a mid-session switch is instant.",
      "documentationUrl": "https://cloud.cerebras.ai"
    }
  },

  // Dependencies are already in the image, so this only wires up the editable
  // install and never touches the network.
  "postCreateCommand": "pip install --user --no-deps -e .",

  // Best effort: bring the proxy up before anyone opens a terminal. If it
  // fails, `.devcontainer/start-agent.sh` is the idempotent way to fix it.
  "postStartCommand": "bash .devcontainer/start-agent.sh --proxy-only || true",

  "forwardPorts": [8000, 8082],
  "portsAttributes": {
    "8000": { "label": "brewd API" },
    "8082": { "label": "Free Claude Code proxy (/admin is loopback-only)" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
